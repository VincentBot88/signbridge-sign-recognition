# ---------------------------------------------------------------------------
# SignBridge — what stays out of git
#
# Rule of thumb: anything that can be regenerated by re-running a script, or
# that came from a licensed dataset, is not committed. See README.md for how
# to rebuild each excluded artifact.
# ---------------------------------------------------------------------------

# Python environment
venv/
env/
.venv/
__pycache__/
*.py[cod]
*.egg-info/
*.whl

# MediaPipe detector models (~8 MB + ~5.5 MB).
# mp_hand_detector.py / mp_body_detector.py download these automatically
# on first run, so they never need to be in the repo.
*.task

# Trained classifiers — 35–45 MB each, rebuilt by train_classifier.py
models/

# Source video clips (ASL Citizen / WLASL — licensed, not redistributable)
data/clips/
data/wlasl_clips/
data/wlasl_raw_cache/

# Per-clip landmark arrays, rebuilt by extract_clip_landmarks.py /
# extract_landmarks_v3.py
data/landmarks/
data/landmarks_v3/
*.npz

# Generated feature matrices — 22–28 MB each, rebuilt by the
# build_feature_vectors*.py scripts
data/features*.csv

# ASL Citizen split CSVs (part of the licensed dataset distribution)
csvs/

# Stray media
*.mp4
*.webm
*.mkv
*.avi
*.mov

# OS / editor noise
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp
